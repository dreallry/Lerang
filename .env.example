# Legacy MySQL source (migration command only; API runtime uses Firebase RTDB)
DB_USER=root
DB_PASS=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_lelang

# Firebase Admin SDK (Backend)
FIREBASE_CREDENTIALS=secrets/firebase-service-account.json
# Firebase Storage diprioritaskan jika bucket aktif.
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
# Opsional: foto publik di disk server Go jika bucket belum tersedia.
# Gunakan disk persisten saat deploy, cadangkan foldernya; kosongkan untuk menonaktifkan.
# Batas 10 MB/file dan total 500 MB. /api/photos harus diproksikan ke Go.
PHOTO_UPLOAD_DIR=uploads/lot-photos
# Realtime Database instance URL from Firebase Console.
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.asia-southeast1.firebasedatabase.app

# Firebase Client Web SDK (Frontend)
VITE_API_BASE_URL=/api
VITE_APP_URL=http://localhost:5173
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id

# Midtrans (Sandbox Payment Gateway)
MIDTRANS_MERCHANT_ID=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Origin website yang boleh mengakses Go API; pisahkan dengan koma.
# Tambahkan origin HTTPS website saat deploy.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
